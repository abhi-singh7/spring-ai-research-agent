# Copy to .env and adjust as needed:  cp .env.example .env

# Pin the Firecrawl stack to a release tag. Bump deliberately when upgrading —
# api, playwright-service and nuq-postgres all use this tag.
FIRECRAWL_VERSION=v2.11.325

# Postgres (NuQ queue) credentials — internal to the compose network only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Worker / concurrency tuning (defaults are fine for a local dev box).
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5
